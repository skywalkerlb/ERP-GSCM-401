#!/bin/sh
# Advisory only: project checks must never block commits, pulls or pushes.
sh "$(git rev-parse --show-toplevel)/scripts/check-design.sh" ||
  echo "Advisory: design checks found issues; review them before your next UI change." >&2
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
other=$(printf '%s\n' "$staged" | grep -vE '^(PROGRESS\.md|docs/progress-archive/)')
if [ -n "$other" ] && ! git diff --cached -U0 -- PROGRESS.md | grep -qE '^\+### [0-9]{4}-[0-9]{2}-[0-9]{2}'; then
  echo "Advisory: update PROGRESS.md for project changes (README.md §9.2)." >&2
fi
exit 0
