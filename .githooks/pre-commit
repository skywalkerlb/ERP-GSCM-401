#!/bin/sh
# Works for every AI tool and every human:
#  1. UI code must follow the Glazed design system (no hard-coded colors/sizes/fonts).
#  2. A commit that changes project files must also add a new changelog entry (### YYYY-MM-DD ...) to PROGRESS.md.
sh "$(git rev-parse --show-toplevel)/scripts/check-design.sh" || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$staged" ] || exit 0
other=$(printf '%s\n' "$staged" | grep -vE '^(PROGRESS\.md|docs/progress-archive/)')
[ -n "$other" ] || exit 0
if printf '%s\n' "$staged" | grep -qx 'PROGRESS.md' &&
   git diff --cached -U0 -- PROGRESS.md | grep -qE '^\+### [0-9]{4}-[0-9]{2}-[0-9]{2}'; then
  exit 0
fi
cat >&2 <<'EOF'
Commit blocked: project files changed, but PROGRESS.md has no new changelog entry staged.
Fix: add an entry at the top of PROGRESS.md > Recent Changes (template is in that section),
update its Status / Next Steps, update README.md if needed, then `git add PROGRESS.md` and commit again.
(See README.md §9.2.)
EOF
exit 1
